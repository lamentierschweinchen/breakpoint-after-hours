{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": "npm ci --ignore-scripts",
  "outputDirectory": "dist",
  "functions": {
    "api/challenge.mjs": { "includeFiles": "dist/index.html" }
  },
  "routes": [
    {
      "src": "^/$",
      "has": [{ "type": "query", "key": "beat", "value": "^(?:100|(?:0|[1-9][0-9]?)(?:\\.[0-9])?)$" }],
      "dest": "/api/challenge"
    },
    { "src": "^/mcp/?$", "dest": "/api/mcp" },
    { "src": "^/board/?$", "dest": "/api/arcade-scores" },
    { "src": "^/badge/runs$", "dest": "/api/arcade-scores" },
    { "handle": "filesystem" }
  ]
}
